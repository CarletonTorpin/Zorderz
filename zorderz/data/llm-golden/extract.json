     "role": "user",
     "content": "7:30 to 4 yesterday with a 30 minute lunch"
    }
   ],
   "json_schema": {
    "type": "object",
    "properties": {
     "start": {
      "type": "string",
      "description": "24-hour HH:MM"
     },
     "end": {
      "type": "string",
      "description": "24-hour HH:MM"
     },
     "break_minutes": {
      "type": "integer"
     }

{
    "name": "carletontorpin/zorderz",
    "description": "Zorderz — open source service business management software for WordPress.",
    "license": "GPL-2.0-or-later",
    "type": "wordpress-theme",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "lint": "phpcs -q --standard=phpcs.xml.dist",
        "security-scan": "phpcs -q --standard=phpcs-security.xml.dist",
        "sentinel": "bash .github/scripts/security-sentinel.sh"
    }
}
